{
  "name": "pushbox-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "pipeline": "python3 scripts/copy_resources.py && python3 scripts/build_pushbox_dsl.py && python3 scripts/transpile_dsl_to_js.py && eslint src/",
    "lint": "eslint src/",
    "dev": "npm run pipeline && vite",
    "venv:pipeline": "source .venv/bin/activate && npm run pipeline",
    "venv:test": "source .venv/bin/activate && python3 scripts/test_transpiler.py",
    "build": "npm run pipeline && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "vite": "^5.0.0",
    "vite-plugin-eslint": "^1.8.1"
  }
}